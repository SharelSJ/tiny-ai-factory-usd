#usda 1.0
(
    defaultPrim = "DataHall_B"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "DataHall_B"
{
    def Xform "Rack_01" (
        prepend references = @rack_configurable.usda@
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Rack_02" (
        prepend references = @rack_configurable.usda@
    )
    {
        double3 xformOp:translate = (2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Rack_03" (
        prepend references = @rack_configurable.usda@
    )
    {
        double3 xformOp:translate = (4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

