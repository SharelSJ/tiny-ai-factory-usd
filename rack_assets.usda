#usda 1.0

def Xform "World"
{
    def Xform "DataHall_A"
    {
        def Xform "Rack_01" (
            prepend references = @rack.usda@
        )
        {
            custom token status = "commissioned"
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "Rack_02" (
            prepend references = @rack.usda@
        )
        {
            double3 xformOp:translate = (2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

