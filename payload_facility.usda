#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "DataHall_A"
    {
        def Xform "Rack_01"
        {
            custom token assetType = "computeRack"
            custom token zone = "DataHall_A"
        }
    }

    def Xform "DataHall_B" (
        prepend payload = @datahall_b.usda@
    )
    {
        double3 xformOp:translate = (0, 5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "Cooling"
    {
        def Xform "CoolingUnit_01"
        {
            custom token assetType = "coolingUnit"
        }
    }
}

