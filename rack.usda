    def Scope "Looks"
    {
        def Material "Frame"
        {
            token outputs:surface.connect = </Rack/Looks/Frame/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.1, 0.12)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Server"
        {
            token outputs:surface.connect = </Rack/Looks/Server/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.02, 0.025)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Accent"
        {
            token outputs:surface.connect = </Rack/Looks/Accent/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0.8, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.35
                token outputs:surface
